{
  "name": "atlas-tierra-media",
  "version": "1.0.0",
  "description": "Atlas interactivo de la Tierra Media: rutas, línea temporal y eventos de El Señor de los Anillos (proyecto fan, sin ánimo de lucro).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test && npm run validate && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melv33n/atlas-tierra-media.git"
  },
  "author": "melv33n",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/melv33n/atlas-tierra-media/issues"
  },
  "homepage": "https://github.com/melv33n/atlas-tierra-media#readme",
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sc": "^5.3.0",
    "leaflet": "^1.9.4"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}
