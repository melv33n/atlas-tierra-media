{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas-tierra-media.local/schemas/geo.schema.json",
  "title": "Capa geográfica propia (GeoJSON en coordenadas [x, y] en millas)",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "properties", "geometry"],
        "properties": {
          "type": {
            "const": "Feature"
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "kind": {
                "enum": [
                  "land",
                  "island",
                  "lake",
                  "range",
                  "hills",
                  "peak",
                  "river",
                  "forest",
                  "marsh",
                  "road",
                  "region",
                  "border"
                ]
              },
              "name": {
                "type": "string"
              },
              "altNames": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "labelZoom": {
                "type": "integer",
                "minimum": -3,
                "maximum": 4
              },
              "smooth": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              },
              "width": {
                "type": "number",
                "minimum": 1,
                "maximum": 200,
                "description": "Anchura de la banda de montañas, en millas."
              },
              "labelAt": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Posición de la etiqueta a lo largo de la línea (0–1)."
              }
            }
          },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {
                "enum": ["Point", "LineString", "MultiLineString", "Polygon", "MultiPolygon"]
              },
              "coordinates": {
                "type": "array"
              }
            }
          }
        }
      }
    }
  }
}
