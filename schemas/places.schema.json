{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas-tierra-media.local/schemas/places.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "type", "coords", "zoomMin"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 1 },
      "altNames": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
      "type": {
        "enum": [
          "ciudad",
          "aldea",
          "fortaleza",
          "torre",
          "morada",
          "puerto",
          "puente",
          "vado",
          "paso",
          "puerta",
          "colina",
          "monte",
          "bosque",
          "valle",
          "campo",
          "lago",
          "cascada",
          "ruina",
          "lugar"
        ]
      },
      "region": { "type": "string" },
      "coords": { "$ref": "xy.schema.json" },
      "zoomMin": { "type": "integer", "minimum": -3, "maximum": 4 },
      "note": { "type": "string" }
    }
  }
}
