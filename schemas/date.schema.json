{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas-tierra-media.local/schemas/date.schema.json",
  "title": "Fecha en Cómputo de la Comarca (meses de 30 días, Tercera Edad)",
  "type": "object",
  "additionalProperties": false,
  "required": ["year"],
  "properties": {
    "year": { "type": "integer", "minimum": 2000, "maximum": 3100 },
    "month": { "type": "integer", "minimum": 1, "maximum": 12 },
    "day": { "type": "integer", "minimum": 1, "maximum": 30 },
    "special": { "enum": ["yule2", "lithe1", "midyear", "overlithe", "lithe2", "yule1"] },
    "precision": { "enum": ["day", "month", "season", "year", "approx"] }
  },
  "dependencies": { "day": ["month"] },
  "not": { "anyOf": [{ "required": ["special", "month"] }, { "required": ["special", "day"] }] }
}
